# Copy this file to .env (same folder) and fill in. .env is git-ignored: never commit keys.
# Gemini API key from https://aistudio.google.com/apikey (use the account that got the hackathon credits)
GEMINI_API_KEY=
# Optional model overrides (check exact ids in AI Studio)
GEMINI_MODEL=gemini-4-argon
GEMINI_ER_MODEL=gemini-4-argon
# dev = laptop CPU, demo = RTX A2000 laptop
SIP_PROFILE=dev
# Optional: where carer alerts are sent (e.g. https://ntfy.sh/<your-private-topic> or a Slack webhook)
CARER_WEBHOOK_URL=
